{
  "name": "re-learning",
  "version": "1.0.0",
  "description": "My Remotion video",
  "repository": {},
  "license": "UNLICENSED",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "private": true,
  "dependencies": {
    "@react-three/fiber": "9.8.2",
    "@react-three/postprocessing": "3.2.2",
    "@remotion/cli": "4.0.543",
    "@remotion/media": "4.0.543",
    "@remotion/sfx": "4.0.543",
    "@remotion/three": "4.0.543",
    "postprocessing": "6.39.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.543",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.543",
    "@types/react": "19.3.0",
    "@types/three": "0.187.0",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "jscpd": "5.4.3",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "dupes:exact": "jscpd src --mode strict --min-tokens 30 --reporters ai --no-tips",
    "dupes:renamed": "jscpd src --mode strict --min-tokens 30 --ignore-identifiers --ignore-literals --reporters ai --no-tips",
    "dupes:near": "jscpd src --mode strict --min-tokens 30 --max-gap-lines 3 --reporters ai --no-tips",
    "dupes:similar": "jscpd src --similarity 0.8 --reporters ai --no-tips",
    "dupes:semantic": "jscpd src --semantic --reporters ai --no-tips",
    "dupes": "npm run dupes:exact && npm run dupes:renamed && npm run dupes:near && npm run dupes:similar && npm run dupes:semantic"
  },
  "allowScripts": {
    "esbuild": false
  }
}
